SELECT last_name||' '||'earns'||to_char(salary,'$99999.00')||' '||'but wants'||' '||
(to_char(salary*3,'$99999.00'))
FROM hr.employees;

SELECT last_name||' '||'earns'||to_char(salary,'$99999.00')||' '||'but wants'||' '||
(to_char(salary * 3,'99999.00'))
FROM hr.employees;


--Q4. Determine the number of managers without listing them. Label the column  Number of Managers Hint: Use the MANAGER_ID column to determine the number of managers. 
SELECT count(manager_id) number_of_managers
FROM hr.employees;

--Q5. Find the difference between the highest and lowest salaries. Label the column DIFFERENCE
SELECT 
      max(salary)-min(salary) difference
FROM hr.employees;

--Q6. Display how many employees joined in each month
Hint: Grouping by month and count the employees .use TO_CHAR functions also

SELECT to_char(hire_date,'day')month,count(emp_id)
FROM hr.employees
group by to_char(hire_date,'day')
order by month;

SELECT to_char(hire_date ,'month')AS MONTH , COUNT(*) AS no_of_employee
FROM hr.employees
GROUP BY to_char(hire_date,'month')
ORDER BY MONTH;

SELECT hire_date FROM hr.employees

--Q7. Display employee id , full name of employees and their hire date only those 
--employees that has greater than 10 year experience in company.

SELECT emp_id,first_name||' '||last_name Full_name,hire_date
FROM hr.employees
WHERE (to_char(hire_date)<sysdate-365*10);

--Q8. Write a query to multipley  salary to commission and calculate the average salary of employees.
Hint: Commission column contain null VALUES

SELECT AVG(salary * nvl(commission_pct,0.5) )AS avg_sal
FROM hr.employees

--Q9.Write a query to display department_id and number of manager under the particular department exclude the null department.
Hint: Grouping on department ID

SELECT department_id , COUNT(manager_id)
FROM hr.employees
WHERE department_id IS NOT NULL
GROUP BY department_id

SELECT * FROM hr.employees

--Q10.Display job title and number of employees working those job and 
--number of manager they perform job.

Job Title   Employees Managers
Accountant  5 1
Accounting Manager  1 1
Administration Assistant  1 1
Administration Vice President 2 1
Finance Manager 1 1
Human Resources Representative  1 1
Marketing Manager 1 1
Sales Representative  30  5
Shipping Clerk  20  5
Stock Clerk 20  5

SELECT count(emp_id),
       count(manager_id),
       j.job_title
FROM hr.employees e, hr.jobs j
WHERE e.job_id=j.job_id and manager_id is not null
group by j.job_title;

--Q11. Display employee full name and pad both side asterisk sing 10 time . Example 

SELECT
       RPAD(LPAD(first_name || ' ' || last_name,
                 LENGTH(first_name || ' ' || last_name) + 10,'*'),
            LENGTH(first_name || ' ' || last_name) + 20,'*') AS padded_full_name
FROM hr.employees;


Q12. Display following output. (Hint: Use Months_between Function)

SELECT emp_id,last_name,hire_date,
round(months_between(sysdate,hire_date)/7) weeks,
round(months_between(sysdate,hire_date)) months,
round(months_between(sysdate,hire_date)/12) years
FROM hr.employees;

SELECT ROUND(months_between(SYSDATE,hire_date)/7) AS weeks FROM hr.employees
