--Q1: Write a query to display the Full name only those employees whose first name 
--start with ‘S’ character.
SELECT emp_id,(substr(first_name,1,1))||'.'||last_name AS Full_Name,salary,hire_date
FROM hr.employees
WHERE first_name like 'S%';

SELECT (SUBSTR(first_name, 1,1)) ||'.'|| last_name AS FULL_NAME FROM hr.employees

--Q2. Find the highest, lowest, sum, and average salary of all employees. Label the columns Maximum
,Minimum, Sum, and Average, respectively. Round your results to the nearest whole number. 

SELECT Round(max(salary)) AS highest,
       Round( MIN(salary)) AS lowest,
        Round(SUM(salary)) AS SUM_salary,
        Round(AVG(salary)) AS avg_salary
FROM hr.employees;

